{
  "name": "gen-image-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @gen-image-studio/api db:generate",
    "db:migrate": "pnpm --filter @gen-image-studio/api db:migrate",
    "db:studio": "pnpm --filter @gen-image-studio/api db:studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}

